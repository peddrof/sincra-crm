# Supabase — projeto de DESENVOLVIMENTO na nuvem (não é produção).
# Painel → Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) ou a anon key legada — as duas funcionam aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...): só no servidor, nunca com prefixo NEXT_PUBLIC_.
# A service_role legada também funciona, em SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Supabase CLI (npx) contra o projeto remoto: link, db push, gen types.
# O ref é o trecho <project-ref> da URL acima. A senha é a do banco, definida ao criar o projeto.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# App (na Vercel: https://gestao.sincra.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cloudflare Zero Trust (Access) — só na publicação. Com os dois preenchidos, toda requisição precisa do token da
# Cloudflare e o login é o do Google (login único). Vazios (PC): login por e-mail e senha.
# Team domain: Zero Trust → Settings → Custom Pages (ex.: sincra.cloudflareaccess.com). AUD: na aplicação do Access → Overview.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Google (Drive + Calendar) — cliente OAuth da conta do Felipe. Passo a passo: docs/10-integracao-google.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENTES_FOLDER_ID=
GOOGLE_DRIVE_TRANSCRICOES_FOLDER_ID=
# Criptografa o token do Google guardado no banco. Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Reuniões: "manual" (padrão) = resumo feito no Claude/ChatGPT e trazido para a plataforma; "ollama" = modelo local, só no PC.
IA_PROVEDOR=manual
# IA local (Ollama), só com IA_PROVEDOR=ollama. Modelo baixado com: ollama pull <modelo>
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Sem assinatura eletrônica integrada (contrato assinado pelo gov.br) — nenhuma chave necessária.

# GitHub (feed de atualizações do código) — só depois da publicação
GITHUB_WEBHOOK_SECRET=

# IA (resumos de reunião, resumo do feed, busca no contexto)
ANTHROPIC_API_KEY=

# Web Push (gerar com: npx web-push generate-vapid-keys) — só depois da publicação
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# Fase 3+ — Meta (Instagram / WhatsApp)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Drive pela pasta sincronizada (Google Drive para computador). Só funciona com a plataforma rodando nesse PC.
DRIVE_LOCAL_RAIZ="G:\Meu Drive\ORG. SINCRA"
DRIVE_LOCAL_CLIENTES="60 Documentos/Clientes"
DRIVE_LOCAL_TRANSCRICOES="60 Documentos/Transcrições"
